# Copy to `.env.local` (local) / set in Hostinger panel (production). Never commit real values.

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Strong random secret (server-only), for signing admin JWTs
JWT_SECRET=""

# Public site URL (e.g. https://yourdomain.com)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
