# Copy to `.env.local` (local) / set in Hostinger panel (production). Never commit real values.

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Strong random secret (server-only), for signing admin JWTs
JWT_SECRET=""

# Public site URL (e.g. https://yourdomain.com)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Paddle Billing (v2) — production client-side token.
# Found in Paddle Dashboard → Developer Tools → Authentication → Client-side tokens.
# Format: live_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""

# Optional: Paddle price IDs for Freelancer / Agency / Enterprise tiers.
# Personal tier uses built-in production price IDs. Without these env vars,
# non-Personal checkout buttons fall back to the order form link.
# NEXT_PUBLIC_PADDLE_PRICE_FREELANCER_STARTER=
# NEXT_PUBLIC_PADDLE_PRICE_FREELANCER_GROWTH=
# NEXT_PUBLIC_PADDLE_PRICE_FREELANCER_PRO=
# NEXT_PUBLIC_PADDLE_PRICE_FREELANCER_SCALE=
# NEXT_PUBLIC_PADDLE_PRICE_AGENCY_STARTER=
# NEXT_PUBLIC_PADDLE_PRICE_AGENCY_GROWTH=
# NEXT_PUBLIC_PADDLE_PRICE_AGENCY_PRO=
# NEXT_PUBLIC_PADDLE_PRICE_AGENCY_SCALE=
# NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_STARTER=
# NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_GROWTH=
# NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_PRO=
# NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_SCALE=
